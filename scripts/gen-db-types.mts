/**
 * Generates src/types/database.ts from the SQL migrations by applying them
 * to an in-memory PGlite database and introspecting the public schema.
 *
 * The output follows the shape produced by `supabase gen types`, so the
 * file can later be regenerated against the hosted project with
 * `pnpm db:types` without changing application code.
 */
import { writeFileSync } from "node:fs";
import path from "node:path";
import { createTestDb } from "../tests/db/harness.ts";

const t = await createTestDb();
const q = async <T,>(sql: string) => (await t.db.query<T>(sql)).rows;

const enums = await q<{ name: string; values: string[] }>(`
  select t.typname as name, array_agg(e.enumlabel order by e.enumsortorder) as values
  from pg_type t join pg_enum e on e.enumtypid = t.oid join pg_namespace n on n.oid = t.typnamespace
  where n.nspname = 'public' group by t.typname order by t.typname`);
const enumNames = new Set(enums.map((e) => e.name));

function tsType(udt: string, isArray = false): string {
  const base = udt.replace(/^_/, "");
  let ts: string;
  if (enumNames.has(base)) ts = `Database["public"]["Enums"]["${base}"]`;
  else if (["int2", "int4", "int8", "float4", "float8", "numeric"].includes(base)) ts = "number";
  else if (base === "bool") ts = "boolean";
  else if (base === "json" || base === "jsonb") ts = "Json";
  else if (base === "void") ts = "undefined";
  else ts = "string";
  return isArray || udt.startsWith("_") ? `${ts}[]` : ts;
}

type Column = {
  table_name: string;
  column_name: string;
  udt_name: string;
  is_nullable: "YES" | "NO";
  column_default: string | null;
  is_generated: string;
  is_identity: string;
  table_type: string;
};

const columns = await q<Column>(`
  select c.table_name, c.column_name, c.udt_name, c.is_nullable, c.column_default, c.is_generated, c.is_identity, tb.table_type
  from information_schema.columns c
  join information_schema.tables tb on tb.table_schema = c.table_schema and tb.table_name = c.table_name
  where c.table_schema = 'public'
  order by c.table_name, c.ordinal_position`);

const fks = await q<{ table_name: string; name: string; columns: string[]; ref_table: string; ref_columns: string[]; one_to_one: boolean }>(`
  select cl.relname as table_name, con.conname as name,
    array(select a.attname from unnest(con.conkey) with ordinality as k(num, ord) join pg_attribute a on a.attrelid = con.conrelid and a.attnum = k.num order by k.ord) as columns,
    rcl.relname as ref_table,
    array(select a.attname from unnest(con.confkey) with ordinality as k(num, ord) join pg_attribute a on a.attrelid = con.confrelid and a.attnum = k.num order by k.ord) as ref_columns,
    exists (
      select 1 from pg_index i where i.indrelid = con.conrelid and i.indisunique and i.indpred is null and i.indkey::int2[] @> con.conkey and array_length(i.indkey::int2[], 1) = array_length(con.conkey, 1)
    ) as one_to_one
  from pg_constraint con
  join pg_class cl on cl.oid = con.conrelid join pg_namespace n on n.oid = cl.relnamespace
  join pg_class rcl on rcl.oid = con.confrelid join pg_namespace rn on rn.oid = rcl.relnamespace
  where con.contype = 'f' and n.nspname = 'public' and rn.nspname = 'public'
  order by cl.relname, con.conname`);

const functions = await q<{
  name: string;
  arg_names: string[] | null;
  arg_types: string[];
  arg_modes: string[] | null;
  n_defaults: number;
  ret_type: string;
  retset: boolean;
}>(`
  select p.proname as name, p.proargnames as arg_names,
    array(select t.typname from unnest(coalesce(p.proallargtypes, p.proargtypes::oid[])) with ordinality as x(typ, ord) join pg_type t on t.oid = x.typ order by x.ord) as arg_types,
    p.proargmodes::text[] as arg_modes, p.pronargdefaults as n_defaults,
    rt.typname as ret_type, p.proretset as retset
  from pg_proc p join pg_namespace n on n.oid = p.pronamespace join pg_type rt on rt.oid = p.prorettype
  where n.nspname = 'public' and rt.typname <> 'trigger' and has_function_privilege('authenticated', p.oid, 'execute')
  order by p.proname`);

const byTable = new Map<string, Column[]>();
for (const c of columns) {
  if (!byTable.has(c.table_name)) byTable.set(c.table_name, []);
  byTable.get(c.table_name)!.push(c);
}

const ind = (n: number) => " ".repeat(n);
let out = `// Generated by scripts/gen-db-types.mts from supabase/migrations. Do not edit by hand.
// Regenerate with \`pnpm db:types:local\` (or \`pnpm db:types\` against the linked project).

export type Json = string | number | boolean | null | { [key: string]: Json | undefined } | Json[];

export type Database = {
  public: {
    Tables: {
`;

function relationships(table: string): string {
  const rels = fks.filter((f) => f.table_name === table);
  if (rels.length === 0) return "[]";
  return `[\n${rels
    .map(
      (r) =>
        `${ind(10)}{\n${ind(12)}foreignKeyName: "${r.name}";\n${ind(12)}columns: [${r.columns.map((c) => `"${c}"`).join(", ")}];\n${ind(12)}isOneToOne: ${r.one_to_one};\n${ind(12)}referencedRelation: "${r.ref_table}";\n${ind(12)}referencedColumns: [${r.ref_columns.map((c) => `"${c}"`).join(", ")}];\n${ind(10)}},`,
    )
    .join("\n")}\n${ind(8)}]`;
}

for (const [table, cols] of byTable) {
  if (cols[0].table_type !== "BASE TABLE") continue;
  const row = cols.map((c) => `${ind(10)}${c.column_name}: ${tsType(c.udt_name)}${c.is_nullable === "YES" ? " | null" : ""};`);
  const insert = cols.map((c) => {
    if (c.is_generated === "ALWAYS" || (c.is_identity === "YES")) return `${ind(10)}${c.column_name}?: never;`;
    const optional = c.is_nullable === "YES" || c.column_default !== null;
    return `${ind(10)}${c.column_name}${optional ? "?" : ""}: ${tsType(c.udt_name)}${c.is_nullable === "YES" ? " | null" : ""};`;
  });
  const update = cols.map((c) => {
    if (c.is_generated === "ALWAYS" || c.is_identity === "YES") return `${ind(10)}${c.column_name}?: never;`;
    return `${ind(10)}${c.column_name}?: ${tsType(c.udt_name)}${c.is_nullable === "YES" ? " | null" : ""};`;
  });
  out += `${ind(6)}${table}: {\n${ind(8)}Row: {\n${row.join("\n")}\n${ind(8)}};\n${ind(8)}Insert: {\n${insert.join("\n")}\n${ind(8)}};\n${ind(8)}Update: {\n${update.join("\n")}\n${ind(8)}};\n${ind(8)}Relationships: ${relationships(table)};\n${ind(6)}};\n`;
}

out += `${ind(4)}};\n${ind(4)}Views: {\n`;
for (const [view, cols] of byTable) {
  if (cols[0].table_type !== "VIEW") continue;
  const row = cols.map((c) => `${ind(10)}${c.column_name}: ${tsType(c.udt_name)} | null;`);
  out += `${ind(6)}${view}: {\n${ind(8)}Row: {\n${row.join("\n")}\n${ind(8)}};\n${ind(8)}Relationships: [];\n${ind(6)}};\n`;
}

out += `${ind(4)}};\n${ind(4)}Functions: {\n`;
for (const f of functions) {
  const modes = f.arg_modes ?? f.arg_types.map(() => "i");
  const names = f.arg_names ?? [];
  const inputs: string[] = [];
  const outputs: string[] = [];
  const inCount = modes.filter((m) => m === "i" || m === "b").length;
  let inIndex = 0;
  modes.forEach((mode, i) => {
    const name = names[i] ?? `arg${i}`;
    const type = tsType(f.arg_types[i]);
    if (mode === "i" || mode === "b") {
      const optional = inIndex >= inCount - f.n_defaults;
      inputs.push(`${ind(10)}${name}${optional ? "?" : ""}: ${type};`);
      inIndex++;
    }
    if (mode === "t" || mode === "o" || mode === "b") outputs.push(`${ind(12)}${name}: ${type};`);
  });
  const args = inputs.length ? `{\n${inputs.join("\n")}\n${ind(8)}}` : "never";
  let returns: string;
  if (outputs.length) returns = `{\n${outputs.join("\n")}\n${ind(10)}}[]`;
  else returns = tsType(f.ret_type) + (f.retset ? "[]" : "");
  out += `${ind(6)}${f.name}: {\n${ind(8)}Args: ${args};\n${ind(8)}Returns: ${returns};\n${ind(6)}};\n`;
}

out += `${ind(4)}};\n${ind(4)}Enums: {\n`;
for (const e of enums) out += `${ind(6)}${e.name}: ${e.values.map((v) => `"${v}"`).join(" | ")};\n`;
out += `${ind(4)}};\n${ind(4)}CompositeTypes: {\n${ind(6)}[_ in never]: never;\n${ind(4)}};\n  };\n};

type PublicSchema = Database["public"];

export type Tables<T extends keyof PublicSchema["Tables"]> = PublicSchema["Tables"][T]["Row"];
export type TablesInsert<T extends keyof PublicSchema["Tables"]> = PublicSchema["Tables"][T]["Insert"];
export type TablesUpdate<T extends keyof PublicSchema["Tables"]> = PublicSchema["Tables"][T]["Update"];
export type Views<T extends keyof PublicSchema["Views"]> = PublicSchema["Views"][T]["Row"];
export type Enums<T extends keyof PublicSchema["Enums"]> = PublicSchema["Enums"][T];
export type FunctionReturns<T extends keyof PublicSchema["Functions"]> = PublicSchema["Functions"][T]["Returns"];
`;

const target = path.resolve(import.meta.dirname, "..", "src", "types", "database.ts");
writeFileSync(target, out);
console.log(`Wrote ${target}`);
await t.db.close();
